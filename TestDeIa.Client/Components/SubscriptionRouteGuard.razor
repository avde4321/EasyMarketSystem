@inject NavigationManager Navigation
@inject AuthenticationStateProvider Authentication
@inject TestDeIa.Client.Services.Saas.SaasApiClient Saas

@if (allowed)
{
    @ChildContent
}
else
{
    <p role="status">Verificando acceso de la empresa…</p>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool allowed;

    protected override async Task OnInitializedAsync()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/');
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        var authenticated = user.Identity?.IsAuthenticated == true;
        // La administración de plataforma no depende del plan de la empresa seleccionada en el ERP.
        // El componente y el backend conservan su autorización independiente.
        if (user.IsInRole(TestDeIa.Shared.Security.SecurityRoleNames.SuperAdministrador) &&
            (path.Equals("saas/solicitudes-pago", StringComparison.OrdinalIgnoreCase)
             || path.Equals("saas/dashboard", StringComparison.OrdinalIgnoreCase)
             || path.Equals("saas/consumo", StringComparison.OrdinalIgnoreCase)
             || path.Equals("dashboard", StringComparison.OrdinalIgnoreCase) || string.IsNullOrEmpty(path)))
        {
            allowed = true;
            return;
        }
        if (!authenticated || path.Equals("empresa", StringComparison.OrdinalIgnoreCase) ||
            path.Equals("subscription-expired", StringComparison.OrdinalIgnoreCase) ||
            path.Equals("register-tenant", StringComparison.OrdinalIgnoreCase) || path.Equals("registro", StringComparison.OrdinalIgnoreCase) ||
            path.Equals("login", StringComparison.OrdinalIgnoreCase) || path.Equals("logout", StringComparison.OrdinalIgnoreCase))
        {
            allowed = true;
            return;
        }
        try
        {
            var status = await Saas.GetSubscriptionStatusAsync();
            if (status.Activa)
                allowed = true;
            else
                Navigation.NavigateTo(status.Codigo == "EMPRESA_REQUIRED" ? "/empresa" : "/subscription-expired", replace: true);
        }
        catch (HttpRequestException)
        {
            if (string.IsNullOrEmpty(path))
            {
                // Ya estamos en Inicio: mostrar su panel sin repetir la redirección.
                // Las APIs conservan sus validaciones de acceso y suscripción.
                allowed = true;
            }
            else
            {
                Navigation.NavigateTo("/", replace: true);
            }
        }
    }
}
