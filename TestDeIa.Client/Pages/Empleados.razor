@page "/empleados"
@attribute [Authorize]

<PageTitle>Empleados</PageTitle>

<section class="module-page">
    <header class="module-header">
        <div>
            <h1>Empleados</h1>
            <p>Mantenimiento de empleados sobre la persona centralizada.</p>
        </div>
        <button class="primary-action" @onclick="OpenCreateModal">Crear empleado</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert-message">@errorMessage</div>
    }

    <section class="table-card">
        <div class="table-toolbar">
            <InputText class="form-control search-control" @bind-Value="searchTerm" placeholder="Buscar por identificacion, nombre, cargo, contrato, correo o telefono..." />
            <button class="secondary-action" type="button" @onclick="SearchAsync">Buscar</button>
        </div>
        @if (isLoading)
        {
            <p><em>Cargando empleados...</em></p>
        }
        else if (totalCount == 0)
        {
            <div class="empty-state">No hay empleados registrados.</div>
        }
        else if (!VisibleEmpleados.Any())
        {
            <div class="empty-state">No hay resultados para la busqueda actual.</div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table responsive-table">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Identificacion</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Telefono</th>
                            <th>Cargo</th>
                            <th>Ingreso</th>
                            <th>Contrato</th>
                            <th>Roles</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var empleado in VisibleEmpleados)
                        {
                            <tr>
                                <td data-label="Tipo">@empleado.TipoIdentificacion</td>
                                <td data-label="Identificacion">@empleado.Identificacion</td>
                                <td data-label="Nombre">@empleado.NombreCompleto</td>
                                <td data-label="Correo">@empleado.CorreoElectronicoPrincipal</td>
                                <td data-label="Telefono">@empleado.TelefonoCelular</td>
                                <td data-label="Cargo">@(string.IsNullOrWhiteSpace(empleado.CargoPuesto) ? "-" : empleado.CargoPuesto)</td>
                                <td data-label="Ingreso">@(empleado.FechaIngreso?.ToString("yyyy-MM-dd") ?? "-")</td>
                                <td data-label="Contrato">@empleado.TipoContrato</td>
                                <td data-label="Roles">@string.Join(", ", empleado.RolesPersona)</td>
                                <td data-label="Estado"><span class="status-pill">@((empleado.IsActive ? "Activo" : "Inactivo"))</span></td>
                                <td data-label="Acciones" class="row-actions">
                                    <button class="ghost-button" @onclick="() => OpenEditModal(empleado)">Editar</button>
                                    <button class="danger-button" @onclick="() => DeleteEmpleadoAsync(empleado.Id)">Eliminar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="table-footer">
                <span class="table-count">Mostrando @empleados.Count de @totalCount empleados</span>
                <div class="pager-actions">
                    <button class="ghost-button" type="button" @onclick="GoToPreviousPageAsync" disabled="@(!CanGoPrevious)">Anterior</button>
                    <span class="pager-meta">Pagina @PageNumber de @TotalPages</span>
                    <button class="ghost-button" type="button" @onclick="GoToNextPageAsync" disabled="@(!CanGoNext)">Siguiente</button>
                </div>
            </div>
        }
    </section>
</section>

@if (isEditorOpen)
{
    <div class="modal-backdrop">
        <section class="modal-card">
            <header class="modal-header">
                <h2>@(editingEmpleadoId.HasValue ? "Actualizar empleado" : "Crear empleado")</h2>
                <button class="icon-button" @onclick="CloseModal">x</button>
            </header>

            <EditForm Model="empleadoRequest" OnValidSubmit="SaveEmpleadoAsync">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrWhiteSpace(statusMessage))
                {
                    <div class="status-banner">@statusMessage</div>
                }

                <div class="status-banner">
                    Si la persona ya existe por cedula o RUC, se reutiliza y se agrega el rol de empleado sin duplicar sus datos base.
                </div>

                <div class="form-grid">
                    <div class="form-field">
                        <label>Tipo identificacion</label>
                        <InputSelect class="form-control" @bind-Value="empleadoRequest.TipoIdentificacion">
                            @foreach (var item in tiposIdentificacion)
                            {
                                <option value="@item.Codigo">@item.Nombre</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-field">
                        <label>Identificacion</label>
                        <div class="input-action-row">
                            <InputText class="form-control" @bind-Value="empleadoRequest.Identificacion" />
                            <button class="secondary-action" type="button" @onclick="BuscarPersonaAsync" disabled="@isSearchingPersona">
                                @(isSearchingPersona ? "Buscando..." : "Buscar")
                            </button>
                        </div>
                        <ValidationMessage For="@(() => empleadoRequest.Identificacion)" />
                    </div>
                    <div class="form-field full">
                        <label>Razon social / nombres completos</label>
                        <InputText class="form-control" @bind-Value="empleadoRequest.RazonSocialONombresCompletos" />
                        <ValidationMessage For="@(() => empleadoRequest.RazonSocialONombresCompletos)" />
                    </div>
                    <div class="form-field">
                        <label>Nombre comercial</label>
                        <InputText class="form-control" @bind-Value="empleadoRequest.NombreComercial" />
                    </div>
                    <div class="form-field">
                        <label>Correo</label>
                        <InputText class="form-control" @bind-Value="empleadoRequest.CorreoElectronicoPrincipal" />
                        <ValidationMessage For="@(() => empleadoRequest.CorreoElectronicoPrincipal)" />
                    </div>
                    <div class="form-field">
                        <label>Celular</label>
                        <InputText class="form-control" @bind-Value="empleadoRequest.TelefonoCelular" />
                    </div>
                    <div class="form-field">
                        <label>Codigo empleado</label>
                        <InputText class="form-control" @bind-Value="empleadoRequest.CodigoEmpleado" />
                    </div>
                    <div class="form-field">
                        <label>Codigo biometrico</label>
                        <InputText class="form-control" @bind-Value="empleadoRequest.CodigoBiometrico" />
                    </div>
                    <div class="form-field">
                        <label>Fecha ingreso</label>
                        <InputDate class="form-control" @bind-Value="empleadoRequest.FechaIngreso" />
                    </div>
                    <div class="form-field">
                        <label>Fecha salida</label>
                        <InputDate class="form-control" @bind-Value="empleadoRequest.FechaSalida" />
                    </div>
                    <div class="form-field">
                        <label>Tipo contrato</label>
                        <InputText class="form-control" @bind-Value="empleadoRequest.TipoContrato" />
                    </div>
                    <div class="form-field">
                        <label>Cargo / puesto</label>
                        <InputText class="form-control" @bind-Value="empleadoRequest.CargoPuesto" />
                    </div>
                    <div class="form-field">
                        <label>Sueldo base</label>
                        <InputNumber class="form-control" @bind-Value="empleadoRequest.SueldoBase" />
                    </div>
                    <div class="form-field">
                        <label>% comision ventas</label>
                        <InputNumber class="form-control" @bind-Value="empleadoRequest.PorcentajeComisionVentas" />
                    </div>
                    <div class="form-field">
                        <label>Estado laboral</label>
                        <InputText class="form-control" @bind-Value="empleadoRequest.EstadoLaboral" />
                    </div>
                    <div class="form-field">
                        <label>Fecha nacimiento</label>
                        <InputDate class="form-control" @bind-Value="empleadoRequest.FechaNacimiento" />
                    </div>
                    <div class="form-field full">
                        <label>Direccion</label>
                        <InputTextArea class="form-control" @bind-Value="empleadoRequest.DireccionPrincipal" />
                    </div>
                    <div class="form-field">
                        <label>Contacto emergencia</label>
                        <InputText class="form-control" @bind-Value="empleadoRequest.NombreContactoEmergencia" />
                    </div>
                    <div class="form-field">
                        <label>Telefono emergencia</label>
                        <InputText class="form-control" @bind-Value="empleadoRequest.TelefonoEmergencia" />
                    </div>
                </div>

                <label class="form-check soft-check">
                    <InputCheckbox class="form-check-input" @bind-Value="empleadoRequest.IsActive" />
                    <span class="form-check-label">Empleado activo</span>
                </label>

                <footer class="modal-actions">
                    <button class="secondary-action" type="button" @onclick="CloseModal">Cancelar</button>
                    <button class="primary-action" type="submit" disabled="@isSaving">
                        @(isSaving ? "Guardando..." : "Guardar")
                    </button>
                </footer>
            </EditForm>
        </section>
    </div>
}
