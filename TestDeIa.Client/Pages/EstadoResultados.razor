@page "/contabilidad/estado-resultados"
@attribute [Authorize(Policy = SecurityPolicyNames.EmpresaConfigurar)]
@using Microsoft.AspNetCore.Authorization
@using TestDeIa.Client.Components
@using TestDeIa.Client.Services.Contabilidad
@using TestDeIa.Shared.Responses.Contabilidad
@using TestDeIa.Shared.Security
@inject ContabilidadApiClient ContabilidadApiClient

<PageTitle>Estado de Resultados</PageTitle>

<section class="module-page financial-page">
    <header class="module-header">
        <div>
            <h1>Estado de Resultados NIIF</h1>
            <p>Ingresos, costos, gastos y utilidad o pérdida neta antes de participación e impuestos.</p>
        </div>
        <button class="primary-action rounded-xl-button" type="button" @onclick="LoadAsync" disabled="@isLoading">
            @(isLoading ? "Actualizando..." : "Actualizar")
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert-message">@errorMessage</div>
    }

    <section class="summary-grid">
        <article class="summary-card"><span>Ingresos</span><strong>@estado.TotalIngresos.ToString("N2")</strong></article>
        <article class="summary-card"><span>Costos</span><strong>@estado.TotalCostos.ToString("N2")</strong></article>
        <article class="summary-card"><span>Gastos</span><strong>@estado.TotalGastos.ToString("N2")</strong></article>
        <article class="summary-card"><span>Utilidad / pérdida</span><strong>@estado.UtilidadOPerdida.ToString("N2")</strong></article>
    </section>

    <section class="table-card">
        <header class="section-header compact-section-header">
            <div>
                <h2>Resultado del ejercicio</h2>
                <p>Clasificación por códigos contables NIIF para la empresa activa.</p>
            </div>
        </header>

        <div class="table-responsive">
            <table class="data-table financial-tree-table">
                <thead>
                    <tr>
                        <th>Cuenta NIIF</th>
                        <th>Tipo</th>
                        <th class="amount-cell">Saldo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr><td colspan="3" class="empty-state">Cargando estado de resultados...</td></tr>
                    }
                    else
                    {
                        @RenderGroup("Ingresos", estado.Ingresos, estado.TotalIngresos)
                        @RenderGroup("Costos", estado.Costos, estado.TotalCostos)
                        @RenderGroup("Gastos", estado.Gastos, estado.TotalGastos)
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>

@code {
    private readonly HashSet<string> expandedCodes = [];
    private EstadoResultadosResponse estado = new();
    private bool isLoading;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            estado = await ContabilidadApiClient.GetEstadoResultadosAsync();
            ExpandRoots(estado.Ingresos);
            ExpandRoots(estado.Costos);
            ExpandRoots(estado.Gastos);
        }
        catch (HttpRequestException)
        {
            errorMessage = "No se pudo consultar el estado de resultados.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private RenderFragment RenderGroup(string title, IReadOnlyCollection<EstadoFinancieroCuentaResponse> cuentas, decimal total) => @<text>
        <tr class="financial-group-title">
            <td colspan="2">@title</td>
            <td class="amount-cell">@total.ToString("N2")</td>
        </tr>
        @if (cuentas.Count == 0)
        {
            <tr><td colspan="3" class="empty-state">Sin cuentas para @title.ToLowerInvariant().</td></tr>
        }
        else
        {
            @foreach (var cuenta in cuentas)
            {
                <EstadoFinancieroCuentaRow Cuenta="cuenta" ExpandedCodes="expandedCodes" OnToggle="ToggleNode" />
            }
        }
    </text>;

    private void ToggleNode(string codigo)
    {
        if (!expandedCodes.Add(codigo))
        {
            expandedCodes.Remove(codigo);
        }
    }

    private void ExpandRoots(IEnumerable<EstadoFinancieroCuentaResponse> cuentas)
    {
        foreach (var cuenta in cuentas)
        {
            expandedCodes.Add(cuenta.Codigo);
        }
    }
}
