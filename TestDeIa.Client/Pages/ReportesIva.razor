@page "/financiero/reportes/iva"
@attribute [Authorize(Policy = SecurityPolicyNames.FinancieroIva)]

<PageTitle>Reporte IVA</PageTitle>

<section class="module-page iva-page">
    <header class="module-header">
        <div>
            <h1>Reporte mensual de IVA</h1>
            <p>Consolidado tributario de ventas y compras alineado a los casilleros base del Formulario 104.</p>
        </div>
        <button class="primary-action" type="button" @onclick="ConsultarAsync" disabled="@isLoading">
            @(isLoading ? "Consultando..." : "Consultar")
        </button>
    </header>

    <section class="table-card">
        <div class="form-grid iva-filter-grid">
            <div class="form-field">
                <label>Mes</label>
                <InputSelect class="form-control" @bind-Value="selectedMes">
                    @foreach (var mes in meses)
                    {
                        <option value="@mes.Numero">@mes.Nombre</option>
                    }
                </InputSelect>
            </div>
            <div class="form-field">
                <label>Anio</label>
                <InputSelect class="form-control" @bind-Value="selectedAnio">
                    @foreach (var anio in anios)
                    {
                        <option value="@anio">@anio</option>
                    }
                </InputSelect>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert-message">@errorMessage</div>
    }

    @if (!isLoaded && isLoading)
    {
        <section class="table-card">
            <div class="empty-state">Cargando consolidado fiscal...</div>
        </section>
    }
    else if (isLoaded)
    {
        <section class="iva-panels-grid">
            <article class="table-card iva-panel ventas-panel">
                <header class="section-header">
                    <div>
                        <h2>IVA en ventas (Debito fiscal)</h2>
                        <p>Base imponible y valores generados por facturas autorizadas.</p>
                    </div>
                </header>

                <div class="iva-summary-list">
                    @RenderTarifaRow("Tarifa 0%", consolidado.Ventas.Base0, 0m)
                    @RenderTarifaRow("Tarifa 5%", consolidado.Ventas.Base5, consolidado.Ventas.Iva5)
                    @RenderTarifaRow("Tarifa 8%", consolidado.Ventas.Base8, consolidado.Ventas.Iva8)
                    @RenderTarifaRow("Tarifa 15%", consolidado.Ventas.Base15, consolidado.Ventas.Iva15)
                    @RenderHighlightRow("Ventas tarifa diferente de 0%", consolidado.Ventas.BaseTarifaDiferenteCero, consolidado.Ventas.IvaTarifaDiferenteCero)
                </div>
            </article>

            <article class="table-card iva-panel compras-panel">
                <header class="section-header">
                    <div>
                        <h2>IVA en compras (Credito fiscal)</h2>
                        <p>Base imponible y valores originados por compras y liquidaciones registradas.</p>
                    </div>
                </header>

                <div class="iva-summary-list">
                    @RenderTarifaRow("Tarifa 0%", consolidado.Compras.Base0, 0m)
                    @RenderTarifaRow("Tarifa 5%", consolidado.Compras.Base5, consolidado.Compras.Iva5)
                    @RenderTarifaRow("Tarifa 8%", consolidado.Compras.Base8, consolidado.Compras.Iva8)
                    @RenderTarifaRow("Tarifa 15%", consolidado.Compras.Base15, consolidado.Compras.Iva15)
                    @RenderHighlightRow("Compras locales tarifa diferente de 0%", consolidado.Compras.BaseTarifaDiferenteCero, consolidado.Compras.IvaTarifaDiferenteCero)
                </div>
            </article>
        </section>

        <section class="table-card iva-result-card">
            <header class="section-header">
                <div>
                    <h2>Resultado fiscal del periodo</h2>
                    <p>Resumen neto para auditoria tributaria del mes consultado.</p>
                </div>
            </header>

            <div class="result-grid">
                <div class="result-box">
                    <span>Debito fiscal</span>
                    <strong>@consolidado.DebitoFiscal.ToString("C2")</strong>
                </div>
                <div class="result-box">
                    <span>Credito fiscal</span>
                    <strong>@consolidado.CreditoFiscal.ToString("C2")</strong>
                </div>
                <div class="result-box">
                    <span>Factor de proporcionalidad</span>
                    <strong>@consolidado.FactorProporcionalidad.ToString("0.0000")</strong>
                </div>
                <div class="result-box result-box-accent">
                    <span>IVA neto a pagar</span>
                    <strong>@consolidado.IvaNetoPagar.ToString("C2")</strong>
                    <small>Credito tributario: @consolidado.CreditoTributario.ToString("C2")</small>
                </div>
            </div>
        </section>

        <section class="table-card ia-card">
            <header class="section-header">
                <div>
                    <h2>Consultor financiero IA (Aprendizaje acumulado)</h2>
                    <p>@consolidado.ContextoPrevioUtilizado</p>
                </div>
                <span class="ia-pill">@(consolidado.TieneAprendizajeAcumulado ? "Con memoria historica" : "Primeras lecturas")</span>
            </header>

            <div class="ia-content">
                @foreach (var bloque in analysisParagraphs)
                {
                    <p>@bloque</p>
                }
            </div>
        </section>
    }
</section>
