@page "/clientes"
@attribute [Authorize(Policy = SecurityPolicyNames.ClientesView)]

<PageTitle>Clientes</PageTitle>

<section class="module-page">
    <header class="module-header">
        <div>
            <h1>Clientes</h1>
            <p>Consulta y mantenimiento de clientes relacionados con personas.</p>
        </div>
        <button class="primary-action" @onclick="OpenCreateModal">Crear cliente</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert-message">@errorMessage</div>
    }

    <section class="table-card">
        <div class="table-toolbar">
            <InputText class="form-control search-control" @bind-Value="searchTerm" placeholder="Buscar por identificacion, razon social, correo, telefono o tipo de cliente..." />
            <button class="secondary-action" type="button" @onclick="SearchAsync">Buscar</button>
        </div>
        <div class="soft-info-message compact-message">
            La busqueda respeta la empresa activa y reutiliza la persona centralizada cuando ya existe.
        </div>
        @if (isLoading)
        {
            <p><em>Cargando clientes...</em></p>
        }
        else if (totalCount == 0)
        {
            <div class="empty-state">No hay clientes registrados.</div>
        }
        else if (!VisibleClientes.Any())
        {
            <div class="empty-state">No hay resultados para la busqueda actual.</div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table responsive-table">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Identificacion</th>
                            <th>Nombre</th>
                            <th>Direccion</th>
                            <th>Correo principal</th>
                            <th>Tipo cliente</th>
                            <th>Credito</th>
                            <th>Roles</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cliente in VisibleClientes)
                        {
                            <tr>
                                <td data-label="Tipo">@cliente.TipoIdentificacion</td>
                                <td data-label="Identificacion">@cliente.Identificacion</td>
                                <td data-label="Nombre">@cliente.NombreCompleto</td>
                                <td data-label="Direccion">@cliente.DireccionPrincipal</td>
                                <td data-label="Correo">@cliente.CorreoElectronicoPrincipal</td>
                                <td data-label="Tipo cliente">@cliente.TipoCliente</td>
                                <td data-label="Credito">@(cliente.PermiteCredito ? $"{cliente.LimiteCredito:n2} / {cliente.DiasCreditoMaximo} dias" : "No")</td>
                                <td data-label="Roles">@string.Join(", ", cliente.RolesPersona)</td>
                                <td data-label="Estado"><span class="status-pill">@((cliente.IsActive ? "Activo" : "Inactivo"))</span></td>
                                <td data-label="Acciones" class="row-actions">
                                    <button class="ghost-button" @onclick="() => OpenEditModal(cliente)">Editar</button>
                                    <button class="danger-button" @onclick="() => DeleteClienteAsync(cliente.Id)">Eliminar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="table-footer">
                <span class="table-count">Mostrando @clientes.Count de @totalCount clientes</span>
                <div class="pager-actions">
                    <button class="ghost-button" type="button" @onclick="GoToPreviousPageAsync" disabled="@(!CanGoPrevious)">Anterior</button>
                    <span class="pager-meta">Pagina @PageNumber de @TotalPages</span>
                    <button class="ghost-button" type="button" @onclick="GoToNextPageAsync" disabled="@(!CanGoNext)">Siguiente</button>
                </div>
            </div>
        }
    </section>
</section>

@if (isEditorOpen)
{
    <div class="modal-backdrop">
        <section class="modal-card">
            <header class="modal-header">
                <h2>@(editingClienteId.HasValue ? "Actualizar cliente" : "Crear cliente")</h2>
                <button class="icon-button" @onclick="CloseModal">x</button>
            </header>

            <EditForm Model="clienteRequest" OnValidSubmit="SaveClienteAsync">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrWhiteSpace(statusMessage))
                {
                    <div class="status-banner dynamic-status-banner">@statusMessage</div>
                }

                <div class="status-banner">
                    Si la persona ya existe por cedula o RUC, se reutiliza y se agrega el rol de cliente sin duplicar sus datos base.
                </div>

                <div class="form-grid">
                    <div class="form-field">
                        <label for="tipoIdentificacion">Tipo identificacion</label>
                        <InputSelect id="tipoIdentificacion" class="form-control" @bind-Value="clienteRequest.TipoIdentificacion">
                            @foreach (var item in tiposIdentificacion)
                            {
                                <option value="@item.Codigo">@item.Nombre</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => clienteRequest.TipoIdentificacion)" />
                    </div>

                    <div class="form-field">
                        <label for="identificacion">Identificacion</label>
                        <div class="input-action-row">
                            <InputText id="identificacion" class="form-control" @bind-Value="clienteRequest.Identificacion" />
                            <button class="secondary-action" type="button" @onclick="BuscarPersonaAsync" disabled="@isSearchingPersona">
                                @(isSearchingPersona ? "Buscando..." : "Buscar")
                            </button>
                        </div>
                        <ValidationMessage For="@(() => clienteRequest.Identificacion)" />
                        <small class="file-hint">Consumidor final debe usar 9999999999999.</small>
                    </div>

                    <div class="form-field full">
                        <label for="razonSocial">Razon social / nombres completos</label>
                        <InputText id="razonSocial" class="form-control" @bind-Value="clienteRequest.RazonSocialONombresCompletos" />
                        <ValidationMessage For="@(() => clienteRequest.RazonSocialONombresCompletos)" />
                    </div>

                    <div class="form-field">
                        <label for="nombreComercial">Nombre comercial</label>
                        <InputText id="nombreComercial" class="form-control" @bind-Value="clienteRequest.NombreComercial" />
                        <ValidationMessage For="@(() => clienteRequest.NombreComercial)" />
                    </div>

                    <div class="form-field">
                        <label for="email">Correo principal</label>
                        <InputText id="email" class="form-control" @bind-Value="clienteRequest.CorreoElectronicoPrincipal" />
                        <ValidationMessage For="@(() => clienteRequest.CorreoElectronicoPrincipal)" />
                    </div>

                    <div class="form-field">
                        <label for="correoFacturacion">Correo facturacion electronica</label>
                        <InputText id="correoFacturacion" class="form-control" @bind-Value="clienteRequest.CorreoFacturacionElectronica" />
                        <ValidationMessage For="@(() => clienteRequest.CorreoFacturacionElectronica)" />
                    </div>

                    <div class="form-field">
                        <label for="telefono">Celular</label>
                        <InputText id="telefono" class="form-control" @bind-Value="clienteRequest.TelefonoCelular" />
                        <ValidationMessage For="@(() => clienteRequest.TelefonoCelular)" />
                    </div>

                    <div class="form-field">
                        <label for="tipoCliente">Tipo cliente</label>
                        <InputSelect id="tipoCliente" class="form-control" @bind-Value="clienteRequest.TipoCliente">
                            <option value="Natural">Natural</option>
                            <option value="Juridico">Juridico</option>
                        </InputSelect>
                    </div>

                    <div class="form-field">
                        <label for="genero">Genero</label>
                        <InputText id="genero" class="form-control" @bind-Value="clienteRequest.Genero" />
                    </div>

                    <div class="form-field">
                        <label for="fechaNacimiento">Fecha nacimiento</label>
                        <InputDate id="fechaNacimiento" class="form-control" @bind-Value="clienteRequest.FechaNacimiento" />
                    </div>

                    <div class="form-field full">
                        <label for="direccion">Direccion</label>
                        <InputTextArea id="direccion" class="form-control" @bind-Value="clienteRequest.DireccionPrincipal" />
                        <ValidationMessage For="@(() => clienteRequest.DireccionPrincipal)" />
                        <small class="file-hint">Si el cliente ya existe como persona, estos datos se sincronizan.</small>
                    </div>
                </div>

                <div class="form-grid">
                    <label class="form-check soft-check">
                        <InputCheckbox class="form-check-input" @bind-Value="clienteRequest.ObligadoContabilidad" />
                        <span class="form-check-label">Obligado a llevar contabilidad</span>
                    </label>

                    <label class="form-check soft-check">
                        <InputCheckbox class="form-check-input" @bind-Value="clienteRequest.EsContribuyenteEspecial" />
                        <span class="form-check-label">Contribuyente especial</span>
                    </label>

                    <label class="form-check soft-check">
                        <InputCheckbox class="form-check-input" @bind-Value="clienteRequest.PermiteCredito" />
                        <span class="form-check-label">Permite credito</span>
                    </label>

                    <div class="form-field">
                        <label for="limiteCredito">Limite credito</label>
                        <InputNumber id="limiteCredito" class="form-control" @bind-Value="clienteRequest.LimiteCredito" />
                    </div>

                    <div class="form-field">
                        <label for="diasCredito">Dias credito maximo</label>
                        <InputNumber id="diasCredito" class="form-control" @bind-Value="clienteRequest.DiasCreditoMaximo" />
                    </div>

                    <div class="form-field">
                        <label for="estadoCredito">Estado credito</label>
                        <InputSelect id="estadoCredito" class="form-control" @bind-Value="clienteRequest.EstadoCredito">
                            <option value="AlDia">Al dia</option>
                            <option value="Suspendido">Suspendido</option>
                            <option value="Bloqueado">Bloqueado</option>
                        </InputSelect>
                    </div>
                </div>

                <label class="form-check soft-check">
                    <InputCheckbox class="form-check-input" @bind-Value="clienteRequest.IsActive" />
                    <span class="form-check-label">Cliente activo</span>
                </label>

                <footer class="modal-actions">
                    <button class="secondary-action" type="button" @onclick="CloseModal">Cancelar</button>
                    <button class="primary-action" type="submit" disabled="@isSaving">
                        @(isSaving ? "Guardando..." : "Guardar")
                    </button>
                </footer>
            </EditForm>
        </section>
    </div>
}
