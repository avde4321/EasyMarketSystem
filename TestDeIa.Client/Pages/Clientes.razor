@page "/clientes"
@attribute [Authorize(Policy = SecurityPolicyNames.ClientesView)]

<ProcessingOverlay IsVisible="@(isSaving)" Title="Procesando" Message="Espera hasta que termine la operación." />

<PageTitle>Clientes</PageTitle>

<section class="module-page">
    <header class="module-header">
        <div>
            <h1>Clientes</h1>
            <p>Consulta y mantenimiento de clientes relacionados con personas.</p>
        </div>
        <button class="primary-action" @onclick="OpenCreateModalAsync">Crear cliente</button>
    </header>

    @if (!isEditorOpen && !string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert-message">@errorMessage</div>
    }

    <section class="table-card">
        <div class="table-toolbar">
            <InputText class="form-control search-control" @bind-Value="searchTerm" placeholder="Buscar por identificacion, razon social, correo, telefono o tipo de cliente..." />
            <button class="secondary-action" type="button" @onclick="SearchAsync">Buscar</button>
        </div>
        <div class="soft-info-message compact-message">
            La busqueda respeta la empresa activa y reutiliza la persona centralizada cuando ya existe.
        </div>
        @if (isLoading)
        {
            <p><em>Cargando clientes...</em></p>
        }
        else if (totalCount == 0)
        {
            <EmptyState Icon="users" Title="Aún no hay clientes" Message="Registra el primer cliente de esta empresa para usarlo en ventas y documentos." />
        }
        else if (!VisibleClientes.Any())
        {
            <EmptyState Icon="search" Title="No encontramos clientes" Message="Prueba con otro nombre o identificación, o limpia el filtro de búsqueda." />
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table responsive-table">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Identificacion</th>
                            <th>Nombre</th>
                            <th>Direccion</th>
                            <th>Correo principal</th>
                            <th>Tipo cliente</th>
                            <th>Credito</th>
                            <th>Roles</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cliente in VisibleClientes)
                        {
                            <tr>
                                <td data-label="Tipo">@cliente.TipoIdentificacion</td>
                                <td data-label="Identificacion">@cliente.Identificacion</td>
                                <td data-label="Nombre">@cliente.NombreCompleto</td>
                                <td data-label="Direccion">@cliente.DireccionPrincipal</td>
                                <td data-label="Correo">@cliente.CorreoElectronicoPrincipal</td>
                                <td data-label="Tipo cliente">@cliente.TipoCliente</td>
                                <td data-label="Credito">@(cliente.PermiteCredito ? $"{cliente.LimiteCredito:n2} / {cliente.DiasCreditoMaximo} dias" : "No")</td>
                                <td data-label="Roles">@string.Join(", ", cliente.RolesPersona)</td>
                                <td data-label="Estado"><span class="status-pill">@((cliente.IsActive ? "Activo" : "Inactivo"))</span></td>
                                <td data-label="Acciones" class="row-actions">
                                    <button class="ghost-button" @onclick="() => OpenEditModal(cliente)">Editar</button>
                                    <button class="danger-button" @onclick="() => DeleteClienteAsync(cliente.Id)">Eliminar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="table-footer">
                <span class="table-count">Mostrando @clientes.Count de @totalCount clientes</span>
                <div class="pager-actions">
                    <button class="ghost-button" type="button" @onclick="GoToPreviousPageAsync" disabled="@(!CanGoPrevious)">Anterior</button>
                    <span class="pager-meta">Pagina @PageNumber de @TotalPages</span>
                    <button class="ghost-button" type="button" @onclick="GoToNextPageAsync" disabled="@(!CanGoNext)">Siguiente</button>
                </div>
            </div>
        }
    </section>
</section>

@if (isEditorOpen)
{
    <div class="modal-backdrop">
        <section class="modal-card">
            <header class="modal-header">
                <h2>@(editingClienteId.HasValue ? "Actualizar cliente" : "Crear cliente")</h2>
                <button class="icon-button" @onclick="CloseModal" disabled="@isSaving">x</button>
            </header>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert-message" role="alert">@errorMessage</div>
            }

            @if (!editingClienteId.HasValue && !showClienteRoleForm)
            {
                <section class="client-lookup-panel carousel-pane active-pane">
                    <div class="lookup-heading">
                        <div>
                            <span class="eyebrow">Busqueda previa</span>
                            <h3>Personas disponibles para convertir en cliente</h3>
                            <p>Busca una persona existente y usa la accion de la fila para agregar solamente los datos comerciales faltantes.</p>
                        </div>
                        <button class="secondary-action" type="button" @onclick="NuevoRegistroCliente">Nuevo registro</button>
                    </div>

                    <div class="lookup-search-row">
                        <input class="form-control search-control"
                               value="@personaSearchTerm"
                               @oninput="OnPersonaSearchChangedAsync"
                               placeholder="Buscar persona por identificacion, nombres, correo o telefono..." />
                        <button class="secondary-action" type="button" @onclick="BuscarPersonasCoincidentesAsync" disabled="@(!HasPersonaSearchTerm || isSearchingPersonas)">
                            @(isSearchingPersonas ? "Buscando..." : "Buscar")
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(statusMessage))
                    {
                        <div class="soft-info-message compact-message">@statusMessage</div>
                    }

                    @if (personasCoincidentes.Any())
                    {
                        <div class="lookup-table-scroll">
                            <table class="data-table responsive-table lookup-table">
                                <thead>
                                    <tr>
                                        <th>Identificacion</th>
                                        <th>Nombre / Razon social</th>
                                        <th>Correo</th>
                                        <th>Telefono</th>
                                        <th>Roles</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var persona in personasCoincidentes)
                                    {
                                        <tr>
                                            <td data-label="Identificacion">@persona.Identificacion</td>
                                            <td data-label="Nombre">@persona.RazonSocialONombresCompletos</td>
                                            <td data-label="Correo">@persona.CorreoElectronicoPrincipal</td>
                                            <td data-label="Telefono">@persona.TelefonoCelular</td>
                                            <td data-label="Roles">
                                                @if (persona.RolesPersona.Any())
                                                {
                                                    @string.Join(", ", persona.RolesPersona)
                                                }
                                                else
                                                {
                                                    <span>Sin rol comercial</span>
                                                }
                                            </td>
                                            <td data-label="Accion" class="row-actions">
                                                <button class="ghost-button" type="button" @onclick="() => SeleccionarPersona(persona)" disabled="@TieneRolCliente(persona)">
                                                    @(TieneRolCliente(persona) ? "Ya es cliente" : "Convertir")
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }

            @if (showClienteRoleForm)
            {
            <section class="carousel-pane active-pane">
            <EditForm Model="clienteRequest" OnValidSubmit="SaveClienteAsync" OnInvalidSubmit="OnInvalidClienteSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                @if (!string.IsNullOrWhiteSpace(statusMessage))
                {
                    <div class="soft-info-message compact-message">@statusMessage</div>
                }

                <div class="client-form-divider">
                    <span>@(editingClienteId.HasValue ? "Actualizar datos del cliente" : isClienteFromExistingPersona ? "Completa solo los datos comerciales del cliente" : "Datos para nuevo cliente")</span>
                </div>

                <FormTabs Id="cliente-form-tabs" Items="@clientFormTabs" @bind-ActiveIndex="activeClientTab" AriaLabel="Secciones del cliente" />

                <div id="cliente-form-tabs-panel" class="client-tab-panel" role="tabpanel" aria-labelledby="cliente-form-tabs-tab-@activeClientTab" tabindex="0">
                @if (activeClientTab == 0)
                {
                    @if (ShowPersonaBaseFields)
                    {
                    <div class="form-grid">
                        <div class="form-field full">
                            <label for="tipoCliente">Tipo de cliente</label>
                            <InputSelect id="tipoCliente" class="form-control" @bind-Value="clienteRequest.TipoCliente" @bind-Value:after="OnTipoClienteChanged" disabled="@isSaving">
                                <option value="Natural">Persona natural</option>
                                <option value="Juridico">Empresa / persona jurídica</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => clienteRequest.TipoCliente)" />
                            <small class="file-hint">@(EsClienteJuridico ? "Registra el RUC y la razón social de la empresa." : "Una persona natural puede tener cédula o RUC; tener RUC no la convierte en persona jurídica.")</small>
                        </div>
                        <div class="form-field">
                            <label for="tipoIdentificacion">Tipo de identificación</label>
                            <InputSelect id="tipoIdentificacion" class="form-control" @bind-Value="clienteRequest.TipoIdentificacion" @bind-Value:after="OnTipoIdentificacionChanged">
                                @foreach (var item in tiposIdentificacion) { <option value="@item.Codigo" disabled="@(EsClienteJuridico && item.Codigo != "04")">@item.Nombre</option> }
                            </InputSelect>
                            <ValidationMessage For="@(() => clienteRequest.TipoIdentificacion)" />
                        </div>
                        <div class="form-field">
                            <label for="identificacion">Identificación</label>
                            <div class="input-action-row">
                                <InputText id="identificacion" class="form-control" @bind-Value="clienteRequest.Identificacion" readonly="@EsConsumidorFinal" maxlength="30" />
                                <button class="secondary-action" type="button" @onclick="BuscarPersonaAsync" disabled="@isSearchingPersona">@(isSearchingPersona ? "Buscando..." : "Buscar")</button>
                            </div>
                            <ValidationMessage For="@(() => clienteRequest.Identificacion)" />
                            @if (clienteRequest.TipoIdentificacion == "07") { <small class="file-hint">Consumidor final debe usar 9999999999999.</small> }
                        </div>
                        <div class="form-field full">
                            <label for="razonSocial">@(EsConsumidorFinal ? "Denominación" : EsClienteJuridico ? "Razón social" : "Nombres y apellidos completos") *</label>
                            <InputText id="razonSocial" class="form-control" @bind-Value="clienteRequest.RazonSocialONombresCompletos" readonly="@EsConsumidorFinal" maxlength="180" />
                            <ValidationMessage For="@(() => clienteRequest.RazonSocialONombresCompletos)" />
                        </div>
                    </div>
                    }
                    else
                    {
                        <div class="soft-info-message compact-message">La identificación y los nombres se conservarán desde la persona seleccionada. Continúa en Contacto y Facturación.</div>
                    }
                }
                else if (activeClientTab == 1)
                {
                    <div class="form-grid">
                        @if (MostrarNombreComercial)
                        {
                            <div class="form-field"><label for="nombreComercial">Nombre comercial (opcional)</label><InputText id="nombreComercial" class="form-control" @bind-Value="clienteRequest.NombreComercial" /><ValidationMessage For="@(() => clienteRequest.NombreComercial)" /></div>
                        }
                        <div class="form-field"><label for="email">Correo principal (opcional)</label><InputText id="email" type="email" class="form-control" @bind-Value="clienteRequest.CorreoElectronicoPrincipal" maxlength="180" /><ValidationMessage For="@(() => clienteRequest.CorreoElectronicoPrincipal)" /></div>
                        <div class="form-field"><label for="telefono">Teléfono de contacto (opcional)</label><InputText id="telefono" type="tel" class="form-control" @bind-Value="clienteRequest.TelefonoCelular" maxlength="40" /><ValidationMessage For="@(() => clienteRequest.TelefonoCelular)" /></div>
                        @if (MostrarDatosPersonales)
                        {
                            <div class="form-field"><label for="genero">Género (opcional)</label><InputText id="genero" class="form-control" @bind-Value="clienteRequest.Genero" maxlength="30" /><ValidationMessage For="@(() => clienteRequest.Genero)" /></div>
                            <div class="form-field"><label for="fechaNacimiento">Fecha de nacimiento (opcional)</label><InputDate id="fechaNacimiento" class="form-control" @bind-Value="clienteRequest.FechaNacimiento" /><ValidationMessage For="@(() => clienteRequest.FechaNacimiento)" /></div>
                        }
                        <div class="form-field full"><label>Ubicación</label><GeoAddressPicker @bind-RegionCodigo="clienteRequest.RegionCodigo" @bind-ProvinciaCodigo="clienteRequest.ProvinciaCodigo" @bind-CiudadCodigo="clienteRequest.CiudadCodigo" @bind-SectorCodigo="clienteRequest.SectorCodigo" /></div>
                        <div class="form-field full"><label for="direccion">Dirección exacta / referencia *</label><InputTextArea id="direccion" class="form-control" @bind-Value="clienteRequest.DireccionPrincipal" /><ValidationMessage For="@(() => clienteRequest.DireccionPrincipal)" /><small class="file-hint">Si el cliente ya existe como persona, estos datos se sincronizan.</small></div>
                    </div>
                }
                else
                {
                    <div class="client-form-divider"><span>Facturación y condiciones comerciales</span></div>
                    <div class="form-grid">
                        <div class="form-field full"><label for="correoFacturacion">Correo para comprobantes (opcional)</label><InputText id="correoFacturacion" type="email" class="form-control" @bind-Value="clienteRequest.CorreoFacturacionElectronica" maxlength="180" /><ValidationMessage For="@(() => clienteRequest.CorreoFacturacionElectronica)" /><small class="file-hint">Si se deja vacío se utiliza el correo principal. No cambia el correo de la persona.</small></div>
                        @if (MostrarDatosTributarios)
                        {
                            <label class="form-check soft-check"><InputCheckbox class="form-check-input" @bind-Value="clienteRequest.ObligadoContabilidad" /><span class="form-check-label">Obligado a llevar contabilidad</span></label>
                            <label class="form-check soft-check"><InputCheckbox class="form-check-input" @bind-Value="clienteRequest.EsContribuyenteEspecial" /><span class="form-check-label">Contribuyente especial</span></label>
                        }
                        <label class="form-check soft-check"><InputCheckbox class="form-check-input" @bind-Value="clienteRequest.PermiteCredito" disabled="@EsConsumidorFinal" /><span class="form-check-label">Permite crédito</span></label>
                        <div class="form-field"><label for="limiteCredito">Límite de crédito</label><InputNumber id="limiteCredito" class="form-control" @bind-Value="clienteRequest.LimiteCredito" disabled="@(!clienteRequest.PermiteCredito)" min="0" /><ValidationMessage For="@(() => clienteRequest.LimiteCredito)" /></div>
                        <div class="form-field"><label for="diasCredito">Días de crédito máximo</label><InputNumber id="diasCredito" class="form-control" @bind-Value="clienteRequest.DiasCreditoMaximo" disabled="@(!clienteRequest.PermiteCredito)" min="0" max="3650" /><ValidationMessage For="@(() => clienteRequest.DiasCreditoMaximo)" /></div>
                        <div class="form-field"><label for="estadoCredito">Estado de crédito</label><InputSelect id="estadoCredito" class="form-control" @bind-Value="clienteRequest.EstadoCredito" disabled="@(!clienteRequest.PermiteCredito)"><option value="AlDia">Al día</option><option value="Suspendido">Suspendido</option><option value="Bloqueado">Bloqueado</option></InputSelect><ValidationMessage For="@(() => clienteRequest.EstadoCredito)" /></div>
                    </div>
                    <label class="form-check soft-check"><InputCheckbox class="form-check-input" @bind-Value="clienteRequest.IsActive" /><span class="form-check-label">Cliente activo</span></label>
                }
                </div>

                @if (isClienteFromExistingPersona)
                {
                    <div class="conversion-summary">
                        <span class="conversion-avatar">✓</span>
                        <div>
                            <strong>@clienteRequest.RazonSocialONombresCompletos</strong>
                            <small>@clienteRequest.TipoIdentificacion - @clienteRequest.Identificacion · @(EsClienteJuridico ? "Empresa / persona jurídica" : "Persona natural") · se conservará su clasificación.</small>
                        </div>
                    </div>
                }

                <footer class="modal-actions">
                    <button class="secondary-action" type="button" @onclick="CloseModal" disabled="@isSaving">Cancelar</button>
                    @if (!editingClienteId.HasValue)
                    {
                        <button class="secondary-action" type="button" @onclick="VolverAConsultaPersonasCliente" disabled="@isSaving">Volver a personas</button>
                    }
                    <button class="primary-action" type="submit" disabled="@isSaving">
                        @if (isSaving) { <span class="inline-spinner" aria-hidden="true"></span><span>Guardando...</span> } else { <span>Guardar</span> }
                    </button>
                </footer>
            </EditForm>
            </section>
            }
        </section>
    </div>
}
