@page "/empresa"
@attribute [Authorize]

<PageTitle>Empresa</PageTitle>

<section class="module-page">
    <header class="module-header">
        <div>
            <h1>Mis Empresas</h1>
            <p>Administra multiples RUCs, firmas .p12 y parametros tributarios por empresa.</p>
        </div>
        <button class="primary-action" type="button" @onclick="StartCreate">Nueva empresa</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert-message">@errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="status-banner">@statusMessage</div>
    }

    <section class="table-card">
        <div class="table-toolbar">
            <InputText class="form-control search-control" @bind-Value="searchTerm" placeholder="Buscar empresa por RUC, razon social, ambiente o puntos de emision..." />
        </div>
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>RUC</th>
                        <th>Razon social</th>
                        <th>Ambiente</th>
                        <th>Emision</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (empresas.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="empty-state-cell">Todavia no tienes empresas registradas.</td>
                        </tr>
                    }
                    else if (!FilteredEmpresas.Any())
                    {
                        <tr>
                            <td colspan="6" class="empty-state-cell">No hay empresas que coincidan con la busqueda.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var empresa in FilteredEmpresas)
                        {
                            <tr class="@(selectedEmpresaId == empresa.Id ? "is-selected-row" : string.Empty)">
                                <td>@empresa.Ruc</td>
                                <td>@empresa.RazonSocial</td>
                                <td>@empresa.AmbienteSri</td>
                                <td>
                                    @GetPuntosResumen(empresa)
                                    <small>@($"{empresa.PuntosEmision.Count} punto(s) configurado(s)")</small>
                                </td>
                                <td>
                                    <span class="status-pill @(empresa.IsActive ? "is-active" : "is-inactive")">
                                        @(empresa.IsActive ? "Activa" : "Inactiva")
                                    </span>
                                </td>
                                <td>
                                    <button class="ghost-button" type="button" @onclick="() => SelectEmpresaAsync(empresa.Id)">Editar</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="table-card">
        <EditForm Model="empresaRequest" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            @if (empresaActual is not null)
            {
                <div class="status-banner">
                    Empresa actual: @empresaActual.RazonSocial |
                    Ambiente actual: @empresaActual.AmbienteSri |
                    Certificado: @(empresaActual.TieneCertificadoConfigurado ? "Configurado" : "Pendiente") |
                    Estado: @(empresaActual.IsActive ? "Activo" : "Inactivo")
                </div>
            }

            <div class="form-grid empresa-grid">
                <div class="form-field full">
                    <label>Razon social</label>
                    <InputText class="form-control" @bind-Value="empresaRequest.RazonSocial" />
                    <ValidationMessage For="@(() => empresaRequest.RazonSocial)" />
                </div>
                <div class="form-field full">
                    <label>Nombre comercial</label>
                    <InputText class="form-control" @bind-Value="empresaRequest.NombreComercial" />
                </div>
                <div class="form-field">
                    <label>RUC</label>
                    <InputText class="form-control" @bind-Value="empresaRequest.Ruc" />
                    <ValidationMessage For="@(() => empresaRequest.Ruc)" />
                </div>
                <div class="form-field">
                    <label>Ambiente SRI</label>
                    <InputSelect class="form-control" @bind-Value="empresaRequest.AmbienteSri">
                        @foreach (var item in ambientesSri)
                        {
                            <option value="@item.Codigo">@item.Nombre</option>
                        }
                    </InputSelect>
                    <small class="file-hint">Pruebas usa codigo 1 y Produccion usa codigo 2 en la clave de acceso.</small>
                </div>
                <div class="form-field">
                    <label>Tipo de emision</label>
                    <InputSelect class="form-control" @bind-Value="empresaRequest.TipoEmision">
                        @foreach (var item in tiposEmision)
                        {
                            <option value="@item.Codigo">@item.Nombre</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-field">
                    <label>Modo desarrollo interno</label>
                    <label class="form-check soft-check">
                        <InputCheckbox class="form-check-input" @bind-Value="empresaRequest.ModoDesarrollo" />
                        <span class="form-check-label">Mantener simulacion interna activa</span>
                    </label>
                    <small class="file-hint">Si esta activo, la empresa debe permanecer en ambiente de Pruebas.</small>
                </div>
                <div class="form-field full">
                    <label>Direccion matriz</label>
                    <InputText class="form-control" @bind-Value="empresaRequest.DireccionMatriz" />
                    <ValidationMessage For="@(() => empresaRequest.DireccionMatriz)" />
                </div>
                <div class="form-field full">
                    <div class="puntos-summary-card">
                        <div>
                            <label class="summary-label">Puntos de emision</label>
                            <p class="summary-text">
                                @(empresaRequest.PuntosEmision.Count == 0
                                    ? "Todavia no hay puntos configurados."
                                    : $"{empresaRequest.PuntosEmision.Count} punto(s) configurado(s). Predeterminado: {(empresaRequest.PuntosEmision.FirstOrDefault(p => p.IsDefault)?.Establecimiento ?? "001")}-{(empresaRequest.PuntosEmision.FirstOrDefault(p => p.IsDefault)?.PuntoEmision ?? "001")}")
                            </p>
                        </div>
                        <button class="secondary-action" type="button" @onclick="OpenPuntosEmisionModal">Puntos de emision</button>
                    </div>
                </div>
                <div class="form-field">
                    <label>Obligado a llevar contabilidad</label>
                    <label class="form-check soft-check">
                        <InputCheckbox class="form-check-input" @bind-Value="empresaRequest.ObligadoContabilidad" />
                        <span class="form-check-label">Si</span>
                    </label>
                </div>
                <div class="form-field">
                    <label>Activo</label>
                    <label class="form-check soft-check">
                        <InputCheckbox class="form-check-input" @bind-Value="empresaRequest.IsActive" />
                        <span class="form-check-label">Configuracion activa</span>
                    </label>
                </div>
                <div class="form-field">
                    <label>Contribuyente especial</label>
                    <InputText class="form-control" @bind-Value="empresaRequest.ContribuyenteEspecial" />
                </div>
                <div class="form-field">
                    <label>Regimen RIMPE</label>
                    <InputText class="form-control" @bind-Value="empresaRequest.RegimenRimpe" />
                </div>
                <div class="form-field">
                    <label>Agente de retencion</label>
                    <InputText class="form-control" @bind-Value="empresaRequest.AgenteRetencionResolucion" />
                </div>
                <div class="form-field full">
                    <label>Certificado .p12</label>
                    <InputFile class="form-control" OnChange="OnCertificadoSelectedAsync" accept=".p12" />
                    @if (!string.IsNullOrWhiteSpace(certificadoNombreArchivoActual))
                    {
                        <small class="file-hint">
                            Archivo actual: @certificadoNombreArchivoActual
                        </small>
                    }
                </div>
                <div class="form-field full">
                    <label>Clave certificado .p12</label>
                    <InputText class="form-control" type="password" @bind-Value="empresaRequest.CertificadoClave" />
                    <small class="file-hint">En Produccion no deberia quedar vacia si la empresa va a emitir.</small>
                </div>
            </div>

            <footer class="module-actions">
                <button class="primary-action" type="submit" disabled="@isSaving">
                    @(isSaving ? "Guardando..." : (selectedEmpresaId.HasValue ? "Actualizar empresa" : "Crear empresa"))
                </button>
            </footer>
        </EditForm>
    </section>
</section>

@if (showPuntosEmisionModal)
{
    <div class="modal-backdrop">
        <section class="modal-card">
            <div class="modal-header">
                <div>
                    <h2>Puntos de emision</h2>
                    <p>Agrega, revisa y marca el punto predeterminado de la empresa.</p>
                </div>
                <button class="icon-button" type="button" @onclick="ClosePuntosEmisionModal">X</button>
            </div>

            <div class="form-grid point-grid">
                <div class="form-field">
                    <label>Establecimiento</label>
                    <InputText class="form-control" @bind-Value="puntoEmisionDraft.Establecimiento" />
                </div>
                <div class="form-field">
                    <label>Punto de emision</label>
                    <InputText class="form-control" @bind-Value="puntoEmisionDraft.PuntoEmision" />
                </div>
                <div class="form-field full">
                    <label>Direccion establecimiento</label>
                    <InputText class="form-control" @bind-Value="puntoEmisionDraft.DireccionEstablecimiento" />
                </div>
                <div class="form-field full">
                    <label class="form-check soft-check">
                        <InputCheckbox class="form-check-input" @bind-Value="puntoEmisionDraft.IsDefault" />
                        <span class="form-check-label">Usar como punto predeterminado</span>
                    </label>
                </div>
            </div>

            <div class="modal-actions">
                @if (editingPuntoIndex.HasValue)
                {
                    <button class="ghost-button" type="button" @onclick="ResetPuntoEmisionDraft">Cancelar edicion</button>
                }
                <button class="primary-action" type="button" @onclick="AddPuntoEmision">
                    @(editingPuntoIndex.HasValue ? "Actualizar punto" : "Agregar punto")
                </button>
            </div>

            <section class="table-card embedded-card">
                <div class="table-scroll">
                    <table class="data-table responsive-table">
                        <thead>
                            <tr>
                                <th>Establecimiento</th>
                                <th>Punto</th>
                                <th>Direccion</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (empresaRequest.PuntosEmision.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="empty-state-cell">Todavia no has agregado puntos de emision.</td>
                                </tr>
                            }
                            else
                            {
                                @for (var index = 0; index < empresaRequest.PuntosEmision.Count; index++)
                                {
                                    var punto = empresaRequest.PuntosEmision[index];

                                    <tr>
                                        <td data-label="Establecimiento">@punto.Establecimiento</td>
                                        <td data-label="Punto">@punto.PuntoEmision</td>
                                        <td data-label="Direccion">@(string.IsNullOrWhiteSpace(punto.DireccionEstablecimiento) ? "Sin direccion" : punto.DireccionEstablecimiento)</td>
                                        <td data-label="Estado">
                                            <span class="status-pill @(punto.IsDefault ? "is-active" : string.Empty)">
                                                @(punto.IsDefault ? "Predeterminado" : "Secundario")
                                            </span>
                                        </td>
                                        <td data-label="Acciones">
                                            <div class="row-actions">
                                                <button class="ghost-button" type="button" @onclick="() => EditPuntoEmision(index)">Editar</button>
                                                <button class="secondary-action" type="button" @onclick="() => SetDefaultPuntoEmision(index)">Predeterminar</button>
                                                <button class="danger-button" type="button" @onclick="() => RemovePuntoEmision(index)">Quitar</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <div class="modal-actions">
                <button class="primary-action" type="button" @onclick="ClosePuntosEmisionModal">Listo</button>
            </div>
        </section>
    </div>
}
