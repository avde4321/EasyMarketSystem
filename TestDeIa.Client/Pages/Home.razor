@page "/"
@attribute [Authorize(Policy = SecurityPolicyNames.DashboardView)]

<PageTitle>Inicio</PageTitle>

<AuthorizeView Roles="Administrador,Gerente">
    <Authorized Context="managerContext">
        <DashboardGerencial />
    </Authorized>
    <NotAuthorized Context="managerDeniedContext">
        <AuthorizeView Roles="Cajero,AsesorComercial">
            <Authorized Context="cashierContext">
                <DashboardCajero />
            </Authorized>
            <NotAuthorized Context="cashierDeniedContext">
                <section class="dashboard-page">
                    <div class="dashboard-section empty-state">
                        Tu perfil no tiene un dashboard operativo asignado. Solicita al administrador revisar tus roles.
                    </div>
                </section>
            </NotAuthorized>
        </AuthorizeView>
    </NotAuthorized>
</AuthorizeView>
