@page "/personas"
@attribute [Authorize(Policy = SecurityPolicyNames.PersonasView)]

<PageTitle>Personas</PageTitle>

<section class="module-page">
    <header class="module-header">
        <div>
            <h1>Personas</h1>
            <p>Informacion personal centralizada para usuarios y clientes.</p>
        </div>
        <button class="primary-action" @onclick="OpenCreateModal">Crear persona</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert-message">@errorMessage</div>
    }

    <section class="table-card">
        <div class="table-toolbar">
            <InputText class="form-control search-control" @bind-Value="searchTerm" placeholder="Buscar por identificacion, razon social, correo, telefono o rol..." />
            <button class="secondary-action" type="button" @onclick="SearchAsync">Buscar</button>
        </div>
        @if (isLoading)
        {
            <p><em>Cargando personas...</em></p>
        }
        else if (personas.Count == 0)
        {
            <div class="empty-state">No hay personas registradas.</div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table responsive-table">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Identificacion</th>
                            <th>Nombre</th>
                            <th>Nombre comercial</th>
                            <th>F. nacimiento</th>
                            <th>Correo</th>
                            <th>Telefono</th>
                            <th>Roles</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var persona in VisiblePersonas)
                        {
                            <tr>
                                <td data-label="Tipo">@persona.TipoIdentificacion</td>
                                <td data-label="Identificacion">@persona.Identificacion</td>
                                <td data-label="Nombre">@persona.NombreCompleto</td>
                                <td data-label="Nombre comercial">@(persona.NombreComercial ?? "-")</td>
                                <td data-label="F. nacimiento">@(persona.FechaNacimiento?.ToString("yyyy-MM-dd") ?? "-")</td>
                                <td data-label="Correo">@persona.CorreoElectronicoPrincipal</td>
                                <td data-label="Telefono">@persona.TelefonoCelular</td>
                                <td data-label="Roles">@(persona.RolesPersona.Count == 0 ? "-" : string.Join(", ", persona.RolesPersona))</td>
                                <td data-label="Estado"><span class="status-pill">@((persona.IsActive ? "Activa" : "Inactiva"))</span></td>
                                <td data-label="Acciones">
                                    <div class="row-actions">
                                        <button class="ghost-button" @onclick="() => OpenEditModal(persona)">Editar</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <footer class="table-footer">
                <span class="table-count">@totalCount persona(s) registradas</span>
                <div class="pager-actions">
                    <button class="ghost-button" type="button" @onclick="GoToPreviousPageAsync" disabled="@(!CanGoPrevious)">Anterior</button>
                    <span class="pager-meta">Pagina @PageNumber de @TotalPages</span>
                    <button class="ghost-button" type="button" @onclick="GoToNextPageAsync" disabled="@(!CanGoNext)">Siguiente</button>
                </div>
            </footer>
        }
    </section>
</section>

@if (isEditorOpen)
{
    <div class="modal-backdrop">
        <section class="modal-card">
            <header class="modal-header">
                <h2>@(editingPersonaId.HasValue ? "Actualizar persona" : "Crear persona")</h2>
                <button class="icon-button" @onclick="CloseModal">x</button>
            </header>

            <EditForm Model="personaRequest" OnValidSubmit="SavePersonaAsync">
                <DataAnnotationsValidator />

                <div class="form-grid">
                    <div class="form-field">
                        <label for="tipoIdentificacion">Tipo identificacion</label>
                        <InputSelect id="tipoIdentificacion" class="form-control" @bind-Value="personaRequest.TipoIdentificacion">
                            @foreach (var item in tiposIdentificacion)
                            {
                                <option value="@item.Codigo">@item.Nombre</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => personaRequest.TipoIdentificacion)" />
                    </div>

                    <div class="form-field">
                        <label for="identificacion">Identificacion</label>
                        <InputText id="identificacion" class="form-control" @bind-Value="personaRequest.Identificacion" />
                        <ValidationMessage For="@(() => personaRequest.Identificacion)" />
                        <small class="file-hint">Consumidor final debe usar 9999999999999.</small>
                    </div>

                    <div class="form-field full">
                        <label for="nombres">Razon social / nombres completos</label>
                        <InputText id="nombres" class="form-control" @bind-Value="personaRequest.RazonSocialONombresCompletos" />
                        <ValidationMessage For="@(() => personaRequest.RazonSocialONombresCompletos)" />
                    </div>

                    <div class="form-field">
                        <label for="nombreComercial">Nombre comercial</label>
                        <InputText id="nombreComercial" class="form-control" @bind-Value="personaRequest.NombreComercial" />
                        <ValidationMessage For="@(() => personaRequest.NombreComercial)" />
                    </div>

                    <div class="form-field">
                        <label for="fechaNacimiento">Fecha nacimiento</label>
                        <InputDate id="fechaNacimiento" class="form-control" @bind-Value="personaRequest.FechaNacimiento" />
                    </div>

                    <div class="form-field">
                        <label for="email">Correo</label>
                        <InputText id="email" class="form-control" @bind-Value="personaRequest.CorreoElectronicoPrincipal" />
                        <ValidationMessage For="@(() => personaRequest.CorreoElectronicoPrincipal)" />
                    </div>

                    <div class="form-field">
                        <label for="telefono">Telefono</label>
                        <InputText id="telefono" class="form-control" @bind-Value="personaRequest.TelefonoCelular" />
                        <ValidationMessage For="@(() => personaRequest.TelefonoCelular)" />
                    </div>

                    <div class="form-field">
                        <label for="genero">Genero</label>
                        <InputText id="genero" class="form-control" @bind-Value="personaRequest.Genero" />
                    </div>

                    <div class="form-field full">
                        <label for="direccion">Direccion</label>
                        <InputTextArea id="direccion" class="form-control" @bind-Value="personaRequest.DireccionPrincipal" />
                        <ValidationMessage For="@(() => personaRequest.DireccionPrincipal)" />
                    </div>
                </div>

                <label class="form-check soft-check">
                    <InputCheckbox class="form-check-input" @bind-Value="personaRequest.IsActive" />
                    <span class="form-check-label">Persona activa</span>
                </label>

                <footer class="modal-actions">
                    <button class="secondary-action" type="button" @onclick="CloseModal">Cancelar</button>
                    <button class="primary-action" type="submit" disabled="@isSaving">
                        @(isSaving ? "Guardando..." : "Guardar")
                    </button>
                </footer>
            </EditForm>
        </section>
    </div>
}
