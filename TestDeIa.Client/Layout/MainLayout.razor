@using System.IdentityModel.Tokens.Jwt
@using System.Security.Claims
@using TestDeIa.Shared.Security
@using TestDeIa.Shared.Sri
@implements IDisposable
@inherits LayoutComponentBase
@inject TestDeIa.Client.Services.Empresa.EmpresaApiClient EmpresaApiClient
@inject TestDeIa.Client.Services.Empresa.EmpresaSessionService EmpresaSessionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<div class="page @(isSidebarCollapsed ? "sidebar-collapsed" : string.Empty) @(isMobileSidebarOpen ? "mobile-sidebar-open" : string.Empty)">
    @if (isMobileSidebarOpen)
    {
        <button class="sidebar-backdrop" type="button" @onclick="CloseMobileSidebar" aria-label="Cerrar menu lateral"></button>
    }

    <aside class="sidebar">
        <NavMenu IsCollapsed="isSidebarCollapsed" OnToggle="ToggleSidebar" AllowOperationalNavigation="true" />
    </aside>

    <main>
        <header class="top-row">
            <div class="top-brand">
                <button class="mobile-menu-button" type="button" @onclick="ToggleMobileSidebar" aria-label="Abrir menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <img class="top-brand-image" src="brand/easymarket-wordmark.svg" alt="EasyMarket Systems" />
            </div>
            <Breadcrumbs />
            <div class="top-actions">
                @if (selectedEmpresa is not null)
                {
                    <div class="sri-environment-badge @GetAmbienteBadgeClass(selectedEmpresa.AmbienteSri)" title="Ambiente activo de emisión SRI">
                        <span>Ambiente SRI</span>
                        <strong>@GetAmbienteBadgeText(selectedEmpresa.AmbienteSri)</strong>
                    </div>
                }
                <div class="user-context-card compact-user-card">
                    <span class="summary-label">Usuario</span>
                    <strong>@loggedInUserName</strong>
                    <small>@loggedInIdentification</small>
                </div>
                <div class="company-switch">
                    <label for="empresa-global">@(isPlatformOwner ? "Mi empresa operativa" : "Empresa")</label>
                    <select id="empresa-global" class="company-select" @bind="selectedEmpresaId" @bind:after="OnEmpresaChangedAsync">
                        @if (empresas.Count == 0)
                        {
                            <option value="">Sin empresas</option>
                        }
                        else
                        {
                            @foreach (var empresa in empresas)
                            {
                                <option value="@empresa.Id.ToString()">@($"{empresa.RazonSocial} - {empresa.Ruc}")</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </header>

        @if (isPlatformOwner && empresas.Count == 0 && !IsCompanySetupPage)
        {
            <section class="owner-company-setup" role="status">
                <div>
                    <strong>@(empresaLoadFailed ? "No se pudo cargar tu empresa operativa" : "Configura la empresa con la que operarás el ERP")</strong>
                    <p>@(empresaLoadFailed
                        ? "Vuelve a consultar la configuración de tu empresa. El ERP no abrirá módulos con un contexto incompleto."
                        : "El portal SaaS administra solicitudes y consumo; para usar POS, caja e inventario necesitas una empresa propia. Aquí solo se mostrarán tus empresas, nunca las de tus clientes.")</p>
                </div>
                <a class="primary-action" href="empresa?origen=erp">@(empresaLoadFailed ? "Revisar empresa" : "Configurar empresa propia")</a>
            </section>
        }

        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    private bool isSidebarCollapsed;
    private bool isPlatformOwner;
    private bool empresaLoadFailed;
    private bool isMobileSidebarOpen;
    private string? selectedEmpresaId;
    private string loggedInUserName = "Sesión no válida";
    private string loggedInIdentification = "Inicia sesión nuevamente";
    private readonly List<TestDeIa.Shared.Responses.Empresa.EmpresaOptionResponse> empresas = [];
    private bool IsCompanySetupPage => NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
        .Split('?', '#')[0].Trim('/').Equals("empresa", StringComparison.OrdinalIgnoreCase);
    private TestDeIa.Shared.Responses.Empresa.EmpresaOptionResponse? selectedEmpresa =>
        Guid.TryParse(selectedEmpresaId, out var empresaId)
            ? empresas.FirstOrDefault(current => current.Id == empresaId)
            : null;

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;
        isPlatformOwner = user.IsInRole(SecurityRoleNames.SuperAdministrador);

        if (user.Identity?.IsAuthenticated == true)
        {
            loggedInUserName = user.FindFirst(JwtRegisteredClaimNames.UniqueName)?.Value
                ?? user.FindFirst("unique_name")?.Value
                ?? user.Identity?.Name
                ?? "Sesion activa";
            loggedInIdentification = user.FindFirst(SecurityClaimTypes.Identification)?.Value
                ?? "Sin identificacion";

            await LoadEmpresasAsync();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
        => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;

    private void ToggleSidebar()
    {
        isSidebarCollapsed = !isSidebarCollapsed;
    }

    private void ToggleMobileSidebar()
    {
        isMobileSidebarOpen = !isMobileSidebarOpen;
    }

    private void CloseMobileSidebar()
    {
        isMobileSidebarOpen = false;
    }

    private async Task LoadEmpresasAsync()
    {
        try
        {
            empresaLoadFailed = false;
            empresas.Clear();
            empresas.AddRange(await EmpresaApiClient.GetMineAsync());
            selectedEmpresaId = await EmpresaSessionService.GetEmpresaIdAsync();
            if (isPlatformOwner && !empresas.Any(x => x.Id.ToString() == selectedEmpresaId))
            {
                selectedEmpresaId = null;
                await EmpresaSessionService.ClearEmpresaIdAsync();
            }

            if (string.IsNullOrWhiteSpace(selectedEmpresaId) && empresas.Count > 0)
            {
                selectedEmpresaId = empresas.First().Id.ToString();
                await EmpresaSessionService.SetEmpresaIdAsync(empresas.First().Id);
            }
        }
        catch (HttpRequestException)
        {
            empresaLoadFailed = true;
            empresas.Clear();
            selectedEmpresaId = null;
            await EmpresaSessionService.ClearEmpresaIdAsync();
        }
    }

    private async Task OnEmpresaChangedAsync()
    {
        if (Guid.TryParse(selectedEmpresaId, out var empresaId))
        {
            await EmpresaSessionService.SetEmpresaIdAsync(empresaId);
        }
        else
        {
            await EmpresaSessionService.ClearEmpresaIdAsync();
        }

        isMobileSidebarOpen = false;
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    private static string GetAmbienteBadgeText(string? ambienteSri)
    {
        return SriCatalogCodes.NormalizeAmbienteCode(ambienteSri) == "2"
            ? "PRODUCCION"
            : "PRUEBAS";
    }

    private static string GetAmbienteBadgeClass(string? ambienteSri)
    {
        return SriCatalogCodes.NormalizeAmbienteCode(ambienteSri) == "2"
            ? "sri-production"
            : "sri-testing";
    }
}
