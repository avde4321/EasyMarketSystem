@implements IDisposable
@inject NavigationManager NavigationManager

<div class="nav-shell @(IsCollapsed ? "is-collapsed" : string.Empty)">
    <div class="brand-row">
        <a class="brand" href="">
            <img class="brand-mark-image" src="brand/easymarket-mark.svg" alt="EasyMarket Systems" />
            <span class="brand-text">
                <strong>EasyMarket</strong>
                <small>Systems CRM</small>
            </span>
        </a>
        <button class="collapse-button" title="Contraer menu" @onclick="OnToggle">
            <span>@(IsCollapsed ? "+" : "-")</span>
        </button>
    </div>

    <nav class="nav-body">
        <div class="nav-primary">
            <NavLink class="nav-link nav-link-root" href="" Match="NavLinkMatch.All" title="Inicio">
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="icon-svg">
                        <path d="M3 10.5 12 3l9 7.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
                        <path d="M5.5 9.5V20h13V9.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
                        <path d="M9.5 20v-5.5h5V20" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
                    </svg>
                </span>
                <span class="nav-text">Inicio</span>
            </NavLink>

            <section class="nav-group @(IsExpanded("comercial") ? "is-open" : string.Empty)"
                     @onmouseenter='() => ExpandGroup("comercial")'>
                <button type="button"
                        class="nav-group-trigger"
                        @onclick='() => ToggleGroup("comercial")'
                        title="Comercial">
                    <span class="nav-link nav-link-root">
