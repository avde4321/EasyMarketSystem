                                    <path d="M5.5 19c1.2-3.2 3.7-4.8 6.5-4.8s5.3 1.6 6.5 4.8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
                                </svg>
                            </span>
                            <span class="nav-text">Personas</span>
                        </NavLink>
                        <NavLink class="nav-sublink" href="clientes" title="Clientes">
                            <span class="nav-icon nav-icon-sub" aria-hidden="true">
                                <svg viewBox="0 0 24 24" class="icon-svg">
                                    <path d="M4.5 7.5h15l-1.2 7.2a2 2 0 0 1-2 1.7H8.3a2 2 0 0 1-2-1.7L4.5 7.5Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8" />
                                    <path d="M7 7.5V6a2.5 2.5 0 0 1 5 0v1.5m5 0V6a2.5 2.5 0 0 0-5 0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
                                </svg>
                            </span>
                            <span class="nav-text">Clientes</span>
                        </NavLink>
                        <NavLink class="nav-sublink" href="empleados" title="Empleados">
                            <span class="nav-icon nav-icon-sub" aria-hidden="true">
                                <svg viewBox="0 0 24 24" class="icon-svg">
                                    <path d="M7 20v-8.5A2.5 2.5 0 0 1 9.5 9H14a3 3 0 0 0 3-3V4.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
                                    <circle cx="16.5" cy="5.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8" />
                                    <path d="M5 20h14" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
                                </svg>
                            </span>
                            <span class="nav-text">Empleados</span>
                        </NavLink>
                    </div>
                </div>
            </section>

            <section class="nav-group @(IsExpanded("operaciones") ? "is-open" : string.Empty)"
                     @onmouseenter='() => ExpandGroup("operaciones")'>
                <button type="button"
                        class="nav-group-trigger"
                        @onclick='() => ToggleGroup("operaciones")'
                        title="Operaciones">
                    <span class="nav-link nav-link-root">
                        <span class="nav-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" class="icon-svg">
                                <path d="M5 8.5h14v9.5H5z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8" />
                                <path d="M8 8.5V6.8A1.8 1.8 0 0 1 9.8 5h4.4A1.8 1.8 0 0 1 16 6.8v1.7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
                                <path d="M5 12h14" fill="none" stroke="currentColor" stroke-width="1.8" />
                            </svg>
                        </span>
                        <span class="nav-text">Operaciones</span>
                    </span>
                    <span class="nav-caret" aria-hidden="true">
                        <svg viewBox="0 0 20 20" class="caret-svg">
                            <path d="M6 8.5 10 12.5 14 8.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
                        </svg>
                    </span>
                </button>

                <div class="nav-group-panel">
                    <div class="nav-submenu">
                        <NavLink class="nav-sublink" href="inventario" title="Inventario">
                            <span class="nav-icon nav-icon-sub" aria-hidden="true">
                                <svg viewBox="0 0 24 24" class="icon-svg">
                                    <path d="M4.5 7 12 3l7.5 4-7.5 4-7.5-4Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8" />
                                    <path d="M4.5 7v10l7.5 4 7.5-4V7" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8" />
                                    <path d="M12 11v10" fill="none" stroke="currentColor" stroke-width="1.8" />
                                </svg>
                            </span>
                            <span class="nav-text">Inventario</span>
                        </NavLink>
                        <NavLink class="nav-sublink" href="facturacion/pos" title="POS">
                            <span class="nav-icon nav-icon-sub" aria-hidden="true">
                                <svg viewBox="0 0 24 24" class="icon-svg">
                                    <rect x="5" y="4.5" width="14" height="15" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8" />
                                    <path d="M8 8h8M8 11.5h3M13 11.5h3M8 15h8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
                                </svg>
                            </span>
                            <span class="nav-text">POS</span>
                        </NavLink>
                    </div>
                </div>
            </section>

            <section class="nav-group @(IsExpanded("configuracion") ? "is-open" : string.Empty)"
                     @onmouseenter='() => ExpandGroup("configuracion")'>
                <button type="button"
                        class="nav-group-trigger"
                        @onclick='() => ToggleGroup("configuracion")'
                        title="Configuracion">
                    <span class="nav-link nav-link-root">
                        <span class="nav-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" class="icon-svg">
                                <circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8" />
                                <path d="M12 4.5v2.2M12 17.3v2.2M19.5 12h-2.2M6.7 12H4.5M17.3 6.7l-1.6 1.6M8.3 15.7l-1.6 1.6M17.3 17.3l-1.6-1.6M8.3 8.3 6.7 6.7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
                            </svg>
                        </span>
                        <span class="nav-text">Configuracion</span>
                    </span>
                    <span class="nav-caret" aria-hidden="true">
                        <svg viewBox="0 0 20 20" class="caret-svg">
                            <path d="M6 8.5 10 12.5 14 8.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
                        </svg>
                    </span>
                </button>

                <div class="nav-group-panel">
                    <div class="nav-submenu">
                        <NavLink class="nav-sublink" href="empresa" title="Empresa">
                            <span class="nav-icon nav-icon-sub" aria-hidden="true">
                                <svg viewBox="0 0 24 24" class="icon-svg">
                                    <path d="M5 20V6.5A1.5 1.5 0 0 1 6.5 5H14v15H5Zm9 0h5V10.5A1.5 1.5 0 0 0 17.5 9H14" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8" />
                                    <path d="M8 9h2M8 12.5h2M8 16h2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
                                </svg>
                            </span>
                            <span class="nav-text">Empresa</span>
                        </NavLink>
                        <NavLink class="nav-sublink" href="facturacion/monitor" title="Comprobantes">
                            <span class="nav-icon nav-icon-sub" aria-hidden="true">
                                <svg viewBox="0 0 24 24" class="icon-svg">
                                    <path d="M7 3.8h8l4 4V20H7z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8" />
                                    <path d="M15 3.8v4h4M10 11h6M10 14.5h6M10 18h4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
                                </svg>
                            </span>
                            <span class="nav-text">Comprobantes</span>
                        </NavLink>
                        <NavLink class="nav-sublink" href="catalogos" title="Catalogos">
                            <span class="nav-icon nav-icon-sub" aria-hidden="true">
                                <svg viewBox="0 0 24 24" class="icon-svg">
                                    <path d="M6 6.5h12M6 12h12M6 17.5h12" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
                                    <circle cx="8" cy="6.5" r="1" fill="currentColor" />
                                    <circle cx="12" cy="12" r="1" fill="currentColor" />
                                    <circle cx="16" cy="17.5" r="1" fill="currentColor" />
                                </svg>
                            </span>
                            <span class="nav-text">Catalogos</span>
                        </NavLink>
                        <AuthorizeView Roles="Administrador">
                            <Authorized>
                                <NavLink class="nav-sublink" href="usuarios" title="Usuarios">
                                    <span class="nav-icon nav-icon-sub" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" class="icon-svg">
                                            <circle cx="9" cy="8" r="2.6" fill="none" stroke="currentColor" stroke-width="1.8" />
                                            <circle cx="16.5" cy="9.5" r="2.1" fill="none" stroke="currentColor" stroke-width="1.8" />
                                            <path d="M4.8 18.5c1.1-2.8 3.2-4.2 5.7-4.2s4.6 1.4 5.7 4.2M14.8 18.2c.5-1.8 1.8-2.9 3.6-3.2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
                                        </svg>
                                    </span>
                                    <span class="nav-text">Usuarios</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </div>
            </section>
        </div>

        <div class="nav-footer">
            <AuthorizeView>
                <Authorized>
                    <NavLink class="nav-link nav-link-root nav-link-logout" href="logout" title="Salir">
                        <span class="nav-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" class="icon-svg">
                                <path d="M10 6H6.8A1.8 1.8 0 0 0 5 7.8v8.4A1.8 1.8 0 0 0 6.8 18H10" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
                                <path d="M13 8.5 17 12l-4 3.5M9 12h8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
                            </svg>
                        </span>
                        <span class="nav-text">Salir</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>
        </div>
    </nav>
</div>

@code {
    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback OnToggle { get; set; }

    private string? expandedGroup;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        SyncExpandedGroupWithRoute();
    }

    protected override void OnParametersSet()
    {
        if (IsCollapsed)
        {
            expandedGroup = null;
        }
        else if (string.IsNullOrWhiteSpace(expandedGroup))
        {
            SyncExpandedGroupWithRoute();
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SyncExpandedGroupWithRoute();
        InvokeAsync(StateHasChanged);
    }

    private void ToggleGroup(string groupKey)
    {
        if (IsCollapsed)
        {
            expandedGroup = groupKey;
            return;
        }

        expandedGroup = expandedGroup == groupKey ? null : groupKey;
    }

    private void ExpandGroup(string groupKey)
    {
        if (!IsCollapsed)
        {
            expandedGroup = groupKey;
        }
    }

    private bool IsExpanded(string groupKey) =>
        string.Equals(expandedGroup, groupKey, StringComparison.OrdinalIgnoreCase);

    private void SyncExpandedGroupWithRoute()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Trim('/').ToLowerInvariant();

        expandedGroup = relativePath switch
        {
            "personas" or "clientes" or "empleados" => "comercial",
            "inventario" or "facturacion/pos" => "operaciones",
            "empresa" or "facturacion/monitor" or "catalogos" or "usuarios" => "configuracion",
            _ => expandedGroup
        };
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
